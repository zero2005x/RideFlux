<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permission declarations for Android BLE. The runtime permission
      prompts (BLUETOOTH_SCAN / BLUETOOTH_CONNECT on API 31+, and
      ACCESS_FINE_LOCATION on earlier releases) are the responsibility
      of the :app module; we only declare them here so that linkages
      into library consumers do not require a separate manifest merge
      step.

      Consumer contract, API <= 30 (this library's minSdk is 26, so
      API 26-30 is fully supported):
        * BLUETOOTH and BLUETOOTH_ADMIN are install-time *normal*
          permissions but are still required by
          BluetoothLeScanner.startScan() and
          BluetoothDevice.connectGatt() on those releases. They are
          declared here so they reach the consuming app's merged
          manifest; without them scan()/connect() throw
          SecurityException on every pre-31 device.
        * ACCESS_FINE_LOCATION must additionally be granted at runtime
          on API <= 30 before scanning; neverForLocation is ignored
          there.

      neverForLocation: this library's scan results carry RSSI
      (DiscoveredWheel.rssi) for signal-strength display only.
      Consumers MUST NOT feed scan results into any proximity,
      ranging or location derivation — doing so would make this
      platform-enforced assertion false and put the app in breach of
      Play policy. See WheelRepositoryImpl.scan().
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- required=false: the library degrades gracefully when BLE is
         absent (scan() fails with an IOException), so each consuming
         app decides whether BLE is mandatory for its use case. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

</manifest>
