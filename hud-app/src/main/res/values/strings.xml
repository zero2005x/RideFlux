  Default (English) strings for :hud-app.

  The glasses viewport is 320 dp wide and the placard type is 40 sp, so
  translations of `hud_*_title` must stay short — prefer a single word per
  line and keep the embedded "\n" where the English has one.

  Every `values-<locale>/` sibling must define exactly the same key set —
  `LocalizationCoverageTest` fails the build otherwise.
-->
<resources>

    <!-- ===== Application / brand ===================================== -->
    <string name="app_name" translatable="false">RideFlux HUD</string>
    <string name="hud_brand_title" translatable="false">RIDEFLUX\nHUD</string>
    <string name="hud_awaiting_target_subtitle" translatable="false">Launch with --es mac &lt;BLE-ADDRESS&gt;</string>
