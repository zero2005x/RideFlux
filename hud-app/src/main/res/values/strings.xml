    <string name="unit_percent" translatable="false">%</string>
    <string name="hud_limit_value" translatable="false">%1$d %2$s</string>
    <string name="hud_step_decrement" translatable="false">−</string>
    <string name="hud_step_increment" translatable="false">+</string>

